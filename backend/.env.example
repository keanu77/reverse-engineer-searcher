# ======================
# LLM Provider 設定
# ======================
LLM_PROVIDER=groq

# Groq API Key (免費申請: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 其他 LLM Provider (可選)
# OPENAI_API_KEY=your_openai_api_key
# GEMINI_API_KEY=your_gemini_api_key
# XAI_API_KEY=your_xai_api_key

# ======================
# PubMed API 設定 (可選，提高 rate limit)
# ======================
# PUBMED_API_KEY=your_pubmed_api_key

# ======================
# Server 設定
# ======================
PORT=3001
NODE_ENV=development

# ======================
# 安全設定
# ======================
# 使用管理者的 LLM API Key 必須設定服務存取碼，並在頁面「進階設定」輸入。
# 未設定時只接受使用者自備 API Key。存取碼不可使用 provider API Key 代替。
# 可執行 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 產生。
# AUTH_API_KEY=replace_with_a_random_service_access_code

# 允許的前端來源（僅前後端跨來源部署時需設定，多個用逗號分隔）
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
